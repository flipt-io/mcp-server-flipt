{
  "name": "@flipt-io/mcp-server-flipt-v2",
  "version": "0.0.1",
  "description": "Model Context Protocol server for Flipt v2",
  "main": "dist/index.js",
  "type": "commonjs",
  "author": "Flipt Devs <dev@flipt.io>",
  "homepage": "https://flipt.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/flipt-io/mcp-server-flipt.git",
    "directory": "packages/mcp-server-flipt-v2"
  },
  "bugs": {
    "url": "https://github.com/flipt-io/mcp-server-flipt/issues"
  },
  "license": "Apache-2.0",
  "bin": {
    "mcp-server-flipt-v2": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node bin/cli.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "prepublishOnly": "pnpm run build",
    "version": "node scripts/sync-version.js && git add src/version.ts",
    "postbuild": "shx chmod +x dist/*.js bin/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.7.0",
    "dotenv": "^16.4.1",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^26.1.1",
    "jest": "^29.7.0",
    "shx": "^0.3.4",
    "ts-jest": "^29.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3"
  }
}
